# Used by npm run config:sync → popup/src/lib/config.secrets.js (gitignored).
# Public anon key is embedded in the extension build; never put the service role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Dashboard may label this "anon" (eyJ...) or "publishable" (sb_publishable_...) — either works:
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Postgres for npm run db:migrate — use Session pooler (not "Direct" db.*.supabase.co on Windows)
# Supabase → Connect → ORM / URI → Session mode. Encode # in password as %23; wrap line in "quotes"
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Edge Functions only (not in extension):
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
LICENSE_ENDPOINT=https://blitz-license.humzab1711.workers.dev

# First developer account (npm run db:seed:developer after you sign up once)
DEVELOPER_EMAIL=you@example.com

# Admin dashboard dev server port (optional)
ADMIN_DEV_PORT=3790

# Comma-separated emails allowed to use developer email OTP on admin login (bootstrap; optional)
# VITE_ADMIN_EMAIL_ALLOWLIST=dev@example.com
