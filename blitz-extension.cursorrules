## STORAGE SCHEMA

### chrome.storage.local keys

```js
{
  // User's base CV as plain text (parsed from uploaded PDF or pasted)
  "cv_text": "string",

  // Structured user profile for screening question answering
  "user_profile": {
    "name": "string",
    "email": "string",
    "phone": "string",
    "location": "string",
    "rightToWork": "string",          // e.g. "Yes - UK Citizen"
    "noticePeriod": "string",         // e.g. "1 month"
    "salaryExpectation": "string",    // e.g. "£55,000"
    "remotePreference": "string",     // "Remote" | "Hybrid" | "On-site"
    "willingToRelocate": false,
    "skills": {                        // Years of experience per skill
      "React": 4,
      "Node.js": 3
    }
  },

  // AI provider config
  "ai_config": {
    "provider": "anthropic",          // "anthropic" | "openai"
    "apiKey": "string",               // Never logged, never sent anywhere except AI API
    "model": "claude-sonnet-4-20250514"
  },

  // License
  "license": {
    "key": "string",
    "tier": "free" | "pro",
    "validatedAt": "ISO timestamp",   // Re-validate every 24hrs
    "applicationsUsed": 0             // Tracked locally, also checked server-side
  },

  // User preferences
  "preferences": {
    "coverLetterMode": "always" | "never" | "ask",
    "autoSubmit": false,              // If true, submit after approve. Default false.
    "dailyLimit": 25,                 // Soft cap shown as recommendation
    "cvTemplate": "modern"            // "modern" | "minimal" | "classic"
  }
}
```

### IndexedDB — "blitz_db"

**Object store: `applications`**

```js
{
  id: "uuid-v4",
  company: "string",
  role: "string",
  url: "string",
  platform: "greenhouse" | "linkedin" | "indeed" | "workday",
  appliedAt: "ISO timestamp",
  status: "applied" | "interview" | "rejected" | "offer" | "withdrawn",
  matchScore: 82,                    // 0-100, generated by AI
  cvSnapshot: "string",              // Tailored CV text used
  coverLetterSnapshot: "string",     // Cover letter text used
  screeningAnswers: [                // Array of Q&A pairs
    { question: "string", answer: "string" }
  ],
  notes: "string"                    // User-editable notes
}
```

