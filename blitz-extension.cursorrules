## LICENSE VALIDATION (license.js)

```js
const LICENSE_ENDPOINT = "https://license.blitz.workers.dev/validate";
// This is a Cloudflare Worker you deploy separately (see CF Worker spec below)

export async function validateLicense(key) {
  const res = await fetch(LICENSE_ENDPOINT, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ key })
  });
  const data = await res.json();
  // Returns { valid: boolean, tier: "pro", message: string }
  return data;
}

export async function checkLicenseStatus() {
  const stored = await getStorage("license");
  if (!stored?.key) return { tier: "free" };

  // Re-validate if last check was >24hrs ago
  const lastCheck = new Date(stored.validatedAt);
  const hoursSince = (Date.now() - lastCheck) / 1000 / 3600;
  if (hoursSince > 24) {
    const result = await validateLicense(stored.key);
    await setStorage("license", { ...stored, tier: result.tier, validatedAt: new Date().toISOString() });
    return result;
  }

  return { tier: stored.tier, valid: true };
}
```

---

## CLOUDFLARE WORKER — License Validator

Deploy separately at `license.blitz.workers.dev`

```js
// KV namespace: LICENSE_KEYS
// Key format: { tier: "pro", createdAt, email, active: true }

export default {
  async fetch(request, env) {
    if (request.method !== "POST") return new Response("Method not allowed", { status: 405 });

    const { key } = await request.json();
    if (!key) return Response.json({ valid: false, message: "No key provided" });

    const record = await env.LICENSE_KEYS.get(key, { type: "json" });

    if (!record || !record.active) {
      return Response.json({ valid: false, tier: "free", message: "Invalid or inactive license" });
    }

    return Response.json({ valid: true, tier: record.tier, message: "License valid" });
  }
}
```

---

## PDF GENERATION (offscreen)

MV3 requires offscreen documents for DOM operations outside the service worker.

offscreen.html loads pdf-generator.js which uses **jsPDF**.

Message flow:
```
popup → background: { type: "GENERATE_PDF", payload: { cvText, template } }
background → offscreen: forwards message
offscreen: generates PDF blob → sends back as base64
background → popup: { type: "PDF_READY", payload: { base64 } }
```

Content scripts receive the base64 and create a File object for the upload input.

