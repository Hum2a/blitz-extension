{
  "manifest_version": 3,
  "name": "Blitz",
  "version": "1.2.0",
  "description": "Apply faster. Land sooner. Blitz tailors your CV and cover letter to every job in seconds.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs",
    "offscreen",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://www.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.indeed.co.uk/*",
    "https://*.myworkdayjobs.com/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://license.blitzai.online/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "popup/dist/dashboard.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://app.blitzai.online/*"
    ]
  },
  "action": {
    "default_popup": "popup/dist/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["content/job-widget.css"],
      "matches": [
        "https://*.greenhouse.io/*",
        "https://www.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.indeed.co.uk/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": [
        "content/page-context.js",
        "content/humanise.js",
        "content/file-upload.js",
        "content/linkedin.js",
        "content/detector.js",
        "content/job-widget.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.indeed.com/*", "https://*.indeed.co.uk/*"],
      "js": [
        "content/page-context.js",
        "content/indeed-helpers.js",
        "content/humanise.js",
        "content/file-upload.js",
        "content/indeed.js",
        "content/detector.js",
        "content/job-widget.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.myworkdayjobs.com/*"],
      "js": [
        "content/page-context.js",
        "content/humanise.js",
        "content/file-upload.js",
        "content/workday.js",
        "content/detector.js",
        "content/job-widget.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.greenhouse.io/*"],
      "js": [
        "content/page-context.js",
        "content/humanise.js",
        "content/file-upload.js",
        "content/greenhouse.js",
        "content/detector.js",
        "content/job-widget.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jobs.lever.co/*", "https://jobs.eu.lever.co/*"],
      "js": [
        "content/page-context.js",
        "content/job-posting-jsonld.js",
        "content/humanise.js",
        "content/file-upload.js",
        "content/lever.js",
        "content/detector.js",
        "content/job-widget.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jobs.ashbyhq.com/*"],
      "js": [
        "content/page-context.js",
        "content/job-posting-jsonld.js",
        "content/humanise.js",
        "content/file-upload.js",
        "content/ashby.js",
        "content/detector.js",
        "content/job-widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
