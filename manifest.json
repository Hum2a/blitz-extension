{
  "manifest_version": 3,
  "name": "Blitz",
  "version": "1.2.0",
  "description": "Apply faster. Land sooner. Blitz tailors your CV and cover letter to every job in seconds.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "tabs", "offscreen"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://www.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.indeed.co.uk/*",
    "https://*.myworkdayjobs.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://blitz-license.humzab1711.workers.dev/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "popup/dist/dashboard.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "matches": ["http://localhost:*/*", "http://127.0.0.1:*/*"]
  },
  "action": {
    "default_popup": "popup/dist/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.indeed.co.uk/*"
      ],
      "js": ["content/humanise.js", "content/file-upload.js", "content/detector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content/linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.indeed.com/*", "https://*.indeed.co.uk/*"],
      "js": ["content/indeed.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.myworkdayjobs.com/*"],
      "js": [
        "content/humanise.js",
        "content/file-upload.js",
        "content/workday.js",
        "content/detector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.greenhouse.io/*"],
      "js": [
        "content/humanise.js",
        "content/file-upload.js",
        "content/greenhouse.js",
        "content/detector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
